#!/usr/bin/env ruby
require 'bundler/setup'
require 'pixie'
require 'numo/pocketfft'
require 'optparse'

$stdin.binmode

this = File.basename(__FILE__)
options = { count: 50 }

o = OptionParser.new do |opts|
  opts.banner = "Usage: #{this} [options]"

  opts.on('-c', '-n', '--count=COUNT', Integer, 'number of lights in strand') do |c|
    options[:count] = c unless c <= 0
  end

  opts.on('-h', '--host=HOST', 'druby URI of the server to connect to.') do |h|
    options[:host] = h
  end
end

o.parse!

unless options[:host]
  puts o.help
  exit(1)
end

puts "Launching #{this} with #{options}"

lights = options[:count] - 1

client = Pixie::Drb::Client.new("druby://#{options[:host]}:8787")
pixie  = client.pixie

MS = 50 # we want ~ms worth of audio
READ_BUF_SIZE = 44_100 * MS / 1000
PROCESS_BUF_SIZE = READ_BUF_SIZE  * 2
BUCKETS = PROCESS_BUF_SIZE / 2
FREQ_PER_BUCKET = 44_100.0 / PROCESS_BUF_SIZE
BASS  = [60, 200]
SNARE = [150, 400]
HI    = [2_000, 4_000]

# A band "hits" when its energy jumps well above its own average over the
# last second, so hits follow the beat rather than the overall volume.
HISTORY    = 20 # frames (~1s)
REFRACTORY = 4  # minimum frames between hits (~200ms)
DECAY      = 0.7
RATIO      = { bass: 1.5, snare: 1.8, hi: 1.8 }.freeze

def hz_to_index(hz)
  (hz / FREQ_PER_BUCKET).round
end

BASS_INDEX  = Range.new(*BASS.map{ |hz| hz_to_index(hz) })
SNARE_INDEX = Range.new(*SNARE.map{ |hz| hz_to_index(hz) })
HI_INDEX    = Range.new(*HI.map{ |hz| hz_to_index(hz) })

def bass_color(index, pct, flip)
  colors = flip ? [270, 270, 17] : [17, 17, 270]
  hue = colors[index % 3]
  "hsl(#{hue}, 80, #{pct}%)"
end

freqs    = %i[bass snare hi].freeze
ranges   = { bass: BASS_INDEX, snare: SNARE_INDEX, hi: HI_INDEX }
last     = { bass: 0.0, snare: 0.0, hi: 0.0 }
history  = { bass: [], snare: [], hi: [] }
last_hit = { bass: -REFRACTORY, snare: -REFRACTORY, hi: -REFRACTORY }
frame    = 0
flip     = false
samples  = []

loop do
  read_buffer = ''
  while read_buffer.length < READ_BUF_SIZE
    chunk = $stdin.read(READ_BUF_SIZE - read_buffer.length)
    exit if chunk.nil? # input closed
    read_buffer += chunk
  end
  samples.concat(read_buffer.bytes.map{|r| (r - 0x80) / 0x80.to_f })

  next if samples.length < PROCESS_BUF_SIZE

  fft = Numo::Pocketfft
          .fft(Numo::NArray.asarray(samples))
          .to_a[0, BUCKETS]
          .map{ |r| r.magnitude * 2 }

  current = {}
  freqs.each do |freq|
    range  = ranges[freq]
    energy = fft[range].sum / range.count
    past   = history[freq]
    hit    = past.size == HISTORY &&
             energy > past.sum / HISTORY * RATIO[freq] &&
             energy > past.last &&
             frame - last_hit[freq] >= REFRACTORY

    last_hit[freq] = frame if hit
    current[freq]  = hit ? 1.0 : last[freq] * DECAY
    past.push(energy)
    past.shift if past.size > HISTORY
  end

  # base colors pulse with the bass, swapping purple/orange on every beat
  flip = !flip if last_hit[:bass] == frame
  pct = 5 + (current[:bass] * 50).floor
  colors = (0..lights).map { |index| bass_color(index, pct, flip) }

  if current[:hi] >= 0.3
    (0..lights).step(6).each do |index|
      colors[index] = 0xffffff
    end
  end

  if current[:snare] >= 0.3
    (3..lights).step(6).each do |index|
      colors[index] = 0xffffff
    end
  end

  pixie[0..lights] = colors
  pixie.render
  samples = samples[READ_BUF_SIZE..-1]

  last = current
  frame += 1
end
